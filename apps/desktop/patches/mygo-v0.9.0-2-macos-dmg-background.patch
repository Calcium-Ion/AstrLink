+func TestDMGConfig(t *testing.T) {
+	ok := DMG{Background: "bg.tiff", Width: 660, Height: 432, AppX: 170, AppY: 190, ApplicationsX: 490, ApplicationsY: 190}
+	for _, tc := range []struct {
+		name string
+		edit func(*DMG)
+		err  string
+	}{
+		{"valid", func(*DMG) {}, ""},
+		{"png", func(d *DMG) { d.Background = "bg.PNG" }, ""},
+		{"jpeg", func(d *DMG) { d.Background = "bg.jpg" }, "TIFF or PNG"},
+		{"no size", func(d *DMG) { d.Height = 0 }, "width and height"},
+		{"app outside", func(d *DMG) { d.AppX = 700 }, "inside the window"},
+		{"link outside", func(d *DMG) { d.ApplicationsY = 0 }, "inside the window"},
+	} {
+		d := ok
+		tc.edit(&d)
+		c := &Config{Name: "App", MacOS: MacOS{DMG: &d}}
+		c.applyDefaults()
+		err := c.validate()
+		if tc.err == "" && err != nil || tc.err != "" && (err == nil || !strings.Contains(err.Error(), tc.err)) {
+			t.Errorf("%s: err = %v, want %q", tc.name, err, tc.err)
+		}
+	}
+}
+
+// TestDMGRecordsBackground checks the records a background adds: an
+// alias in the icon view options, which Finder reads, and a bookmark.
+func TestDMGRecordsBackground(t *testing.T) {
+	bg := &dmgFile{
+		volume: "App", volumeCreated: time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC),
+		volumeSize: 1 << 20, volumeUUID: "D9E30581-4022-3881-B1F1-46F4D8210000",
+		mount: "/Volumes/App", path: []string{".background", "background.tiff"},
+		ids: []uint32{18, 19}, created: time.Date(2026, 1, 2, 3, 4, 6, 0, time.UTC),
+	}
+	layout := DMG{Width: 660, Height: 432, AppX: 170, AppY: 190, ApplicationsX: 490, ApplicationsY: 190}
+	records := dmgRecords("App.app", layout, bg)
+	var icvp, pBBk, bwsp []byte
+	for _, r := range records {
+		switch r.code {
+		case "icvp":
+			icvp = r.value
+		case "pBBk":
+			pBBk = r.value
+		case "bwsp":
+			bwsp = r.value
+		}
+	}
+	alias := bg.alias()
+	if !bytes.Contains(icvp, alias) || !bytes.Contains(icvp, []byte("backgroundImageAlias")) {
+		t.Error("icvp lacks the background's alias")
+	}
+	if int(binary.BigEndian.Uint16(alias[4:])) != len(alias) || !bytes.Contains(alias, []byte("/.background/background.tiff")) {
+		t.Errorf("alias = %x", alias)
+	}
+	if !bytes.HasPrefix(pBBk, []byte("book")) || int(binary.LittleEndian.Uint32(pBBk[4:])) != len(pBBk) {
+		t.Errorf("bookmark = %x", pBBk)
+	}
+	if !bytes.Contains(bwsp, []byte("{660, 432}")) {
+		t.Error("the window is not the layout's size")
+	}
+	if _, err := dsStore(records); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// TestBuildDMGBackground builds a disk image with a background picture
+// and checks that its layout points at the picture in the image.
+func TestBuildDMGBackground(t *testing.T) {
+	c, app, icns := dmgTestApp(t)
+	if err := os.WriteFile(filepath.Join(c.root, "bg.png"), defaultIcon(), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	c.MacOS.DMG = &DMG{Background: "bg.png", Width: 660, Height: 432, AppX: 170, AppY: 190, ApplicationsX: 490, ApplicationsY: 190}
+	if err := c.validate(); err != nil {
+		t.Fatal(err)
+	}
+	dmg, err := buildDMG(c, app, filepath.Dir(app), runtime.GOARCH, buildOptions{sign: "-"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	mnt := attachDMG(t, dmg)
+	if got, err := os.ReadFile(filepath.Join(mnt, ".background", "background.png")); err != nil || !bytes.Equal(got, defaultIcon()) {
+		t.Errorf("the image lacks the background picture: %v", err)
+	}
+	if got, err := os.ReadFile(filepath.Join(mnt, ".VolumeIcon.icns")); err != nil || !bytes.Equal(got, icns) {
+		t.Errorf("the volume icon is not the app's: %v", err)
+	}
+	store, err := os.ReadFile(filepath.Join(mnt, ".DS_Store"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, want := range []string{"backgroundImageAlias", "pBBk", "/.background/background.png", "{660, 432}"} {
+		if !bytes.Contains(store, []byte(want)) && !bytes.Contains(store, utf16BE(want)) {
+			t.Errorf(".DS_Store lacks %q", want)
+		}
+	}
+}
+
+func utf16BE(s string) []byte {
+	var b []byte
+	for _, r := range s {
+		b = binary.BigEndian.AppendUint16(b, uint16(r))
+	}
+	return b
+}
