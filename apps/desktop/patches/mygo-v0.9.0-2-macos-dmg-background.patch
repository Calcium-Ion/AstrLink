diff --git a/cmd/mygo/dmgalias.go b/cmd/mygo/dmgalias.go
new file mode 100644
index 0000000..6b83743
--- /dev/null
+++ b/cmd/mygo/dmgalias.go
@@ -0,0 +1,273 @@
+package main
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"math"
+	"slices"
+	"strings"
+	"time"
+	"unicode/utf16"
+)
+
+// This file encodes where a disk image's background picture is, as Finder
+// reads it from the window's .DS_Store: an alias record among the icon view
+// options (backgroundImageAlias in icvp) and a bookmark (pBBk). Both are
+// what the mac_alias Python package, which dmgbuild uses, writes for the
+// same file with Alias.for_file and Bookmark.for_file.
+
+// dmgFile is what the alias and bookmark of a file in a mounted disk image
+// hold.
+type dmgFile struct {
+	volume        string // the volume's name
+	volumeCreated time.Time
+	volumeSize    uint64 // in bytes
+	volumeUUID    string // upper case
+	mount         string // where the volume is mounted
+	// path names the file and the folders it is in from the volume's
+	// root, as ".background", "picture.tiff"; ids are their catalog node
+	// IDs. The file is in a folder.
+	path    []string
+	ids     []uint32
+	created time.Time // the file's creation date
+}
+
+var (
+	macEpoch = time.Date(1904, 1, 1, 0, 0, 0, 0, time.UTC)
+	cfEpoch  = time.Date(2001, 1, 1, 0, 0, 0, 0, time.UTC)
+)
+
+func (f dmgFile) check() error {
+	if len(f.path) < 2 || len(f.ids) != len(f.path) {
+		return errors.New("the background picture is not in a folder of the disk image")
+	}
+	return nil
+}
+
+// alias encodes the file's alias record, version 2.
+func (f dmgFile) alias() []byte {
+	var b bytes.Buffer
+	put := func(vs ...any) {
+		for _, v := range vs {
+			_ = binary.Write(&b, binary.BigEndian, v)
+		}
+	}
+	tag := func(t int16, data []byte) {
+		put(t, int16(len(data)))
+		b.Write(data)
+		if len(data)%2 == 1 {
+			b.WriteByte(0)
+		}
+	}
+	carbon := func(s string) string { return strings.ReplaceAll(s, ":", "/") }
+	unicode := func(t int16, s string) {
+		u := utf16.Encode([]rune(carbon(s)))
+		put(t, int16(2*len(u)+2), int16(len(u)))
+		for _, c := range u {
+			put(c)
+		}
+	}
+	n := len(f.path)
+	name, folder := f.path[n-1], f.path[n-2]
+	volumeDate := f.volumeCreated.Sub(macEpoch).Seconds()
+	fileDate := f.created.Sub(macEpoch).Seconds()
+
+	b.Write([]byte{0, 0, 0, 0}) // no application
+	put(uint16(0), uint16(2))   // the size, set below, and the version
+	put(uint16(0))              // a file
+	b.Write(pascalString(carbon(f.volume), 28))
+	put(uint32(int64(volumeDate)))
+	b.WriteString("H+")
+	put(uint16(0)) // a fixed disk
+	put(f.ids[n-2])
+	b.Write(pascalString(carbon(name), 64))
+	put(f.ids[n-1], uint32(int64(fileDate)))
+	b.Write(make([]byte, 8))             // no creator, no type
+	put(int16(-1), int16(-1), uint32(0)) // levels from and to, volume attributes
+	b.Write(make([]byte, 12))            // file system ID and reserved
+
+	tag(0, []byte(carbon(folder)))
+	put(int16(16), int16(8), uint64(int64(volumeDate*65536)))
+	put(int16(17), int16(8), uint64(int64(fileDate*65536)))
+	var folders []byte
+	for i := n - 2; i >= 0; i-- {
+		folders = binary.BigEndian.AppendUint32(folders, f.ids[i])
+	}
+	tag(1, folders)
+	parts := make([]string, n)
+	for i, p := range f.path {
+		parts[i] = carbon(p)
+	}
+	tag(2, []byte(f.volume+":"+strings.Join(parts, ":\x00")))
+	unicode(14, name)
+	unicode(15, f.volume)
+	tag(18, []byte("/"+strings.Join(f.path, "/")))
+	tag(19, []byte(f.mount))
+	put(int16(-1), int16(0))
+
+	out := b.Bytes()
+	binary.BigEndian.PutUint16(out[4:], uint16(len(out)))
+	return out
+}
+
+// pascalString is s as a Pascal string in size bytes, as Python's struct
+// packs it: a length byte, then at most size-1 bytes, then zeros.
+func pascalString(s string, size int) []byte {
+	b := make([]byte, size)
+	n := min(len(s), size-1)
+	b[0] = byte(n)
+	copy(b[1:], s[:n])
+	return b
+}
+
+// Bookmark items and keys.
+type (
+	bookmarkData []byte
+	bookmarkURL  string
+)
+
+const (
+	bookmarkPath             = 0x1004
+	bookmarkCNIDPath         = 0x1005
+	bookmarkFileProperties   = 0x1010
+	bookmarkFileCreationDate = 0x1040
+	bookmarkVolumePath       = 0x2002
+	bookmarkVolumeURL        = 0x2005
+	bookmarkVolumeName       = 0x2010
+	bookmarkVolumeUUID       = 0x2011
+	bookmarkVolumeSize       = 0x2012
+	bookmarkVolumeCreated    = 0x2013
+	bookmarkVolumeProperties = 0x2020
+	bookmarkVolumeIsRoot     = 0x2030
+	bookmarkContainingFolder = 0xc001
+	bookmarkUserName         = 0xc011
+	bookmarkUID              = 0xc012
+	bookmarkWasFileReference = 0xd001
+	bookmarkCreationOptions  = 0xd010
+)
+
+// bookmark encodes the file's bookmark.
+func (f dmgFile) bookmark() []byte {
+	threeLongs := func(a, b, c uint64) bookmarkData {
+		d := binary.LittleEndian.AppendUint64(nil, a)
+		d = binary.LittleEndian.AppendUint64(d, b)
+		return binary.LittleEndian.AppendUint64(d, c)
+	}
+	const persistentIDs = 0x100000000
+	names := make([]any, len(f.path))
+	for i, p := range f.path {
+		names[i] = p
+	}
+	ids := make([]any, len(f.ids))
+	for i, id := range f.ids {
+		ids[i] = int64(id)
+	}
+	// In the order Bookmark.for_file lists them.
+	toc := []struct {
+		key   uint32
+		value any
+	}{
+		{bookmarkPath, names},
+		{bookmarkCNIDPath, ids},
+		{bookmarkFileCreationDate, f.created},
+		{bookmarkFileProperties, threeLongs(1, 0x0f, 0)}, // a regular file
+		{bookmarkContainingFolder, int64(len(f.path) - 2)},
+		{bookmarkVolumePath, f.mount},
+		{bookmarkVolumeIsRoot, f.mount == "/"},
+		{bookmarkVolumeURL, bookmarkURL("file://" + f.mount)},
+		{bookmarkVolumeName, f.volume},
+		{bookmarkVolumeSize, int64(f.volumeSize)},
+		{bookmarkVolumeCreated, f.volumeCreated},
+		{bookmarkVolumeUUID, strings.ToUpper(f.volumeUUID)},
+		{bookmarkVolumeProperties, threeLongs(0x81|persistentIDs, 0x13ef|persistentIDs, 0)},
+		{bookmarkCreationOptions, int64(512)},
+		{bookmarkWasFileReference, true},
+		{bookmarkUserName, "unknown"},
+		{bookmarkUID, int64(99)},
+	}
+	// Item offsets count from the end of the 48-byte header; the offset of
+	// the table of contents comes first.
+	offset := 4
+	var items []byte
+	type entry struct{ key, offset uint32 }
+	entries := make([]entry, 0, len(toc))
+	for _, e := range toc {
+		entries = append(entries, entry{e.key, uint32(offset)})
+		var enc []byte
+		offset, enc = bookmarkItem(e.value, offset)
+		items = append(items, enc...)
+	}
+	slices.SortFunc(entries, func(a, b entry) int { return int(a.key) - int(b.key) })
+	var data []byte
+	for _, e := range entries {
+		data = binary.LittleEndian.AppendUint32(data, e.key)
+		data = binary.LittleEndian.AppendUint32(data, e.offset)
+		data = binary.LittleEndian.AppendUint32(data, 0)
+	}
+	first := offset
+	le := binary.LittleEndian
+	out := []byte("book")
+	out = le.AppendUint32(out, uint32(offset+20+len(data)+48))
+	out = le.AppendUint32(out, 0x10040000)
+	out = le.AppendUint32(out, 48)
+	out = append(out, make([]byte, 32)...)
+	out = le.AppendUint32(out, uint32(first))
+	out = append(out, items...)
+	out = le.AppendUint32(out, uint32(len(data)-8))
+	out = le.AppendUint32(out, 0xfffffffe)
+	out = le.AppendUint32(out, 1) // the table's ID
+	out = le.AppendUint32(out, 0) // no next table
+	out = le.AppendUint32(out, uint32(len(entries)))
+	return append(out, data...)
+}
+
+// bookmarkItem encodes v at offset and returns the offset after it,
+// padded to 4 bytes.
+func bookmarkItem(v any, offset int) (int, []byte) {
+	le := binary.LittleEndian
+	head := func(n int, kind uint32) []byte {
+		return le.AppendUint32(le.AppendUint32(nil, uint32(n)), kind)
+	}
+	var b []byte
+	switch v := v.(type) {
+	case bool:
+		b = head(0, 0x0500)
+		if v {
+			b = head(0, 0x0501)
+		}
+	case string:
+		b = append(head(len(v), 0x0101), v...)
+	case bookmarkData:
+		b = append(head(len(v), 0x0201), v...)
+	case bookmarkURL:
+		b = append(head(len(v), 0x0901), v...)
+	case int64:
+		if v > -0x80000000 && v < 0x7fffffff {
+			b = le.AppendUint32(head(4, 0x0303), uint32(int32(v)))
+		} else {
+			b = le.AppendUint64(head(8, 0x0304), uint64(v))
+		}
+	case time.Time:
+		b = binary.BigEndian.AppendUint64(head(8, 0x0400), math.Float64bits(v.Sub(cfEpoch).Seconds()))
+	case []any:
+		b = head(4*len(v), 0x0601)
+		at := offset + 8 + 4*len(v)
+		var elems []byte
+		for _, e := range v {
+			b = le.AppendUint32(b, uint32(at))
+			var enc []byte
+			at, enc = bookmarkItem(e, at)
+			elems = append(elems, enc...)
+		}
+		b = append(b, elems...)
+	default:
+		panic("bookmarkItem: unsupported value")
+	}
+	offset += len(b)
+	if pad := (4 - offset%4) % 4; pad > 0 {
+		b = append(b, make([]byte, pad)...)
+		offset += pad
+	}
+	return offset, b
+}
diff --git a/cmd/mygo/dmgalias_darwin.go b/cmd/mygo/dmgalias_darwin.go
new file mode 100644
index 0000000..4172ba6
--- /dev/null
+++ b/cmd/mygo/dmgalias_darwin.go
@@ -0,0 +1,117 @@
+package main
+
+import (
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"time"
+	"unsafe"
+)
+
+// getattrlist attribute bits (sys/attr.h).
+const (
+	attrBitMapCount = 5
+	attrCmnCrtime   = 0x00000200
+	attrCmnFileID   = 0x02000000
+	attrVolInfo     = 0x80000000
+	attrVolSize     = 0x00000004
+	attrVolName     = 0x00002000
+	attrVolUUID     = 0x00040000
+)
+
+// getAttrs calls getattrlist(2) for path with the common attributes cmn
+// and the volume attributes vol, and returns the attributes after the
+// buffer's length.
+func getAttrs(path string, cmn, vol uint32) ([]byte, error) {
+	// struct attrlist: bitmapcount and reserved, then common, volume,
+	// directory, file and fork attributes.
+	list := [6]uint32{attrBitMapCount, cmn, vol, 0, 0, 0}
+	buf := make([]byte, 1024)
+	p, err := syscall.BytePtrFromString(path)
+	if err != nil {
+		return nil, err
+	}
+	if _, _, e := syscall.Syscall6(syscall.SYS_GETATTRLIST,
+		uintptr(unsafe.Pointer(p)), uintptr(unsafe.Pointer(&list)),
+		uintptr(unsafe.Pointer(&buf[0])), uintptr(len(buf)), 0, 0); e != 0 {
+		return nil, &os.PathError{Op: "getattrlist", Path: path, Err: e}
+	}
+	n := binary.LittleEndian.Uint32(buf)
+	if n < 4 || int(n) > len(buf) {
+		return nil, fmt.Errorf("getattrlist %s: bad length %d", path, n)
+	}
+	return buf[4:n], nil
+}
+
+// timespec reads a struct timespec.
+func timespec(b []byte) time.Time {
+	return time.Unix(int64(binary.LittleEndian.Uint64(b)), int64(binary.LittleEndian.Uint64(b[8:]))).UTC()
+}
+
+// fileID returns the catalog node ID of path.
+func fileID(path string) (uint32, error) {
+	b, err := getAttrs(path, attrCmnFileID, 0)
+	if err != nil {
+		return 0, err
+	}
+	return uint32(binary.LittleEndian.Uint64(b)), nil
+}
+
+// dmgFileOf reads what the alias and bookmark of the file at rel, a path
+// in the volume mounted at mnt, hold.
+func dmgFileOf(mnt, rel string) (*dmgFile, error) {
+	// The volume: its creation date, size, name and UUID, in that order
+	// (common attributes first, then volume attributes by bit).
+	b, err := getAttrs(mnt, attrCmnCrtime, attrVolInfo|attrVolSize|attrVolName|attrVolUUID)
+	if err != nil {
+		return nil, err
+	}
+	if len(b) < 16+8+8+16 {
+		return nil, errors.New("getattrlist: short volume attributes")
+	}
+	f := &dmgFile{volumeCreated: timespec(b)}
+	f.volumeSize = binary.LittleEndian.Uint64(b[16:])
+	ref := b[24:]
+	off, size := int32(binary.LittleEndian.Uint32(ref)), binary.LittleEndian.Uint32(ref[4:])
+	if off < 0 || int(off)+int(size) > len(ref) || size == 0 {
+		return nil, errors.New("getattrlist: bad volume name")
+	}
+	f.volume = string(ref[off : off+int32(size)-1])
+	u := b[32 : 32+16]
+	f.volumeUUID = fmt.Sprintf("%X-%X-%X-%X-%X", u[0:4], u[4:6], u[6:8], u[8:10], u[10:16])
+	// Where the system says the volume is mounted: /private/tmp/x for
+	// /tmp/x.
+	var st syscall.Statfs_t
+	if err := syscall.Statfs(mnt, &st); err != nil {
+		return nil, &os.PathError{Op: "statfs", Path: mnt, Err: err}
+	}
+	on := make([]byte, 0, len(st.Mntonname))
+	for _, c := range st.Mntonname {
+		if c == 0 {
+			break
+		}
+		on = append(on, byte(c))
+	}
+	f.mount = string(on)
+
+	path := mnt
+	for _, name := range strings.Split(filepath.ToSlash(filepath.Clean(rel)), "/") {
+		path = filepath.Join(path, name)
+		id, err := fileID(path)
+		if err != nil {
+			return nil, err
+		}
+		f.path = append(f.path, name)
+		f.ids = append(f.ids, id)
+	}
+	b, err = getAttrs(path, attrCmnCrtime, 0)
+	if err != nil {
+		return nil, err
+	}
+	f.created = timespec(b)
+	return f, f.check()
+}
