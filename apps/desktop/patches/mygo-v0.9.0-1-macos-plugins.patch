+
+func TestPlugInsMustBeNamedExtensionBundles(t *testing.T) {
+	for _, tc := range []struct {
+		plugIns any
+		err     string
+	}{
+		{[]map[string]string{{"path": "build/Widgets.appex"}}, ""},
+		{[]map[string]string{{"path": "build/Widgets.appex", "entitlements": "widgets.plist"}, {"path": "Other.plugin"}}, ""},
+		{[]map[string]string{{"path": "build/Widgets.app"}}, "is not an app extension"},
+		{[]map[string]string{{"path": ""}}, "is not an app extension"},
+		{[]map[string]string{{"path": "a/Widgets.appex"}, {"path": "b/Widgets.appex"}}, "another plug-in is named Widgets.appex"},
+	} {
+		_, err := plugInConfig(t, t.TempDir(), tc.plugIns)
+		if tc.err == "" && err != nil || tc.err != "" && (err == nil || !strings.Contains(err.Error(), tc.err)) {
