+
+// signPlugIns signs the extensions of macos.plugIns in Contents/PlugIns,
+// with their own entitlements, and the code in Contents/Frameworks, which
+// the app's signature then seals without --deep.
+func signPlugIns(c *Config, app, identity string, production bool) error {
+	if len(c.MacOS.PlugIns) == 0 {
+		return nil
+	}
+	sign := func(path, entitlements string) error {
+		args := nestedCodesignArgs(identity, entitlements, production)
+		if out, err := exec.Command("codesign", append(args, path)...).CombinedOutput(); err != nil {
+			return fmt.Errorf("codesign %s: %v\n%s", filepath.Base(path), err, out)
+		}
+		return nil
+	}
+	frameworks := filepath.Join(app, "Contents", "Frameworks")
+	entries, err := os.ReadDir(frameworks)
+	if err != nil && !errors.Is(err, fs.ErrNotExist) {
+		return err
+	}
+	for _, e := range entries {
+		path := filepath.Join(frameworks, e.Name())
+		if ok, _ := machO(path); !ok && !isBundle(path) {
+			continue
+		}
+		if err := sign(path, ""); err != nil {
+			return err
+		}
+	}
+	for _, p := range c.MacOS.PlugIns {
+		entitlements := ""
+		if p.Entitlements != "" {
+			entitlements = c.path(p.Entitlements)
+		}
+		path := filepath.Join(app, "Contents", "PlugIns", filepath.Base(p.Path))
+		if err := sign(path, entitlements); err != nil {
+			return err
+		}
+	}
 	return nil
 }
 
