+// TestSignPlugIns signs an app's extension with its own entitlements
+// before the app, which keeps them.
+func TestSignPlugIns(t *testing.T) {
+	if _, err := exec.LookPath("codesign"); err != nil || runtime.GOOS != "darwin" {
+		t.Skip("needs codesign")
+	}
+	exe, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	root := t.TempDir()
+	plist := func(key string) string {
+		return `<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+<plist version="1.0"><dict><key>` + key + `</key><true/></dict></plist>
+`
+	}
+	writeFiles(t, root, map[string]string{
+		"build/Widgets.appex/Contents/Info.plist": string(infoPlist(&Config{Name: "Widgets", Identifier: "com.example.app.widgets"}, "Widgets", "", "")),
+		"app.plist":     plist("com.apple.security.cs.disable-library-validation"),
+		"widgets.plist": plist("com.apple.security.app-sandbox"),
+	})
+	for _, path := range []string{"app", "build/Widgets.appex/Contents/MacOS/Widgets"} {
+		dst := filepath.Join(root, filepath.FromSlash(path))
+		if err := os.MkdirAll(filepath.Dir(dst), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := copyFile(exe, dst, 0o755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	c, err := plugInConfig(t, root, []map[string]string{{"path": "build/Widgets.appex", "entitlements": "widgets.plist"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	c.MacOS.Entitlements = "app.plist"
+	app, err := writeBundle(c, t.TempDir(), filepath.Join(root, "app"), nil, nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := codesign(c, app, "-", false); err != nil {
+		t.Fatal(err)
+	}
+	if out, err := exec.Command("codesign", "--verify", "--deep", "--strict", app).CombinedOutput(); err != nil {
+		t.Fatalf("the app does not verify: %v\n%s", err, out)
+	}
+	entitlements := func(path string) string {
+		out, err := exec.Command("codesign", "--display", "--entitlements", "-", "--xml", path).CombinedOutput()
+		if err != nil {
+			t.Fatalf("codesign --display %s: %v\n%s", path, err, out)
+		}
+		return string(out)
+	}
+	if out := entitlements(filepath.Join(app, "Contents", "PlugIns", "Widgets.appex")); !strings.Contains(out, "app-sandbox") || strings.Contains(out, "disable-library-validation") {
+		t.Errorf("the extension was not signed with its own entitlements:\n%s", out)
+	}
+	if out := entitlements(app); !strings.Contains(out, "disable-library-validation") {
+		t.Errorf("the app lost its entitlements:\n%s", out)
+	}
+}
