+// copyPlugIns copies the extensions of macos.plugIns into the PlugIns of
+// the bundle's contents.
+func copyPlugIns(c *Config, contents string) error {
+	for _, p := range c.MacOS.PlugIns {
+		src := c.path(p.Path)
+		if !isBundle(src) {
+			return fmt.Errorf("%s: macos.plugIns: %s is not a bundle with an Info.plist", c.configName(), p.Path)
+		}
+		dir := filepath.Join(contents, "PlugIns")
+		if err := os.MkdirAll(dir, 0o755); err != nil {
+			return err
+		}
+		if err := copyResource(src, filepath.Join(dir, filepath.Base(src))); err != nil {
+			return fmt.Errorf("%s: macos.plugIns: %w", c.configName(), err)
+		}
+	}
+	return nil
+}
