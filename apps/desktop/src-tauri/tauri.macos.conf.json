{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "macOS": {
      "hardenedRuntime": true,
      "dmg": {
        "background": "installer/macos-dmg-background.tiff",
        "windowPosition": { "x": 400, "y": 200 },
        "windowSize": { "width": 660, "height": 432 },
        "appPosition": { "x": 170, "y": 190 },
        "applicationFolderPosition": { "x": 490, "y": 190 }
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AstrLink",
        "width": 950,
        "height": 600,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "resizable": true,
        "decorations": true,
        "shadow": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#ffffff"
      }
    ]
  }
}
