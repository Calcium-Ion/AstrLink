{
  "name": "@astrlink/desktop",
  "version": "0.1.0-dev.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "branding:sync": "bun scripts/sync-branding.mjs",
    "dev": "bun run branding:sync && rsbuild dev",
    "dev:typecheck": "tsc --noEmit --watch",
    "build": "bun run branding:sync && tsc --noEmit && rsbuild build",
    "check": "bun run branding:sync && tsc --noEmit && vitest run && rsbuild build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --maxWorkers=1",
    "tauri": "tauri",
    "sidecar:build": "bun scripts/build-sidecar.mjs",
    "desktop:dev": "bun run branding:sync && bun run sidecar:build && tauri dev",
    "desktop:build": "bun run branding:sync && bun run sidecar:build && tauri build"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@lobehub/icons": "5.16.0",
    "@tanstack/react-virtual": "^3.14.10",
    "@tauri-apps/api": "2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "26.4.0",
    "motion": "13.4.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.12",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "overrides": {
    "react-is": "19.2.8"
  },
  "devDependencies": {
    "@rsbuild/core": "2.1.7",
    "@rsbuild/plugin-react": "2.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "happy-dom": "20.8.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vitest": "4.1.0"
  }
}
