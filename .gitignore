*.onnx
*.onnx_data
*.onnx_data_*
*.onnx.data
!**/testdata/*.onnx
!**/testdata/**/*.onnx
!**/testdata/*.onnx_data
!**/testdata/**/*.onnx_data
!**/testdata/*.onnx.data
!**/testdata/**/*.onnx.data
*.safetensors
*.gguf
*.ggml
*.pt
*.pth
*.ckpt
pytorch_model*.bin
tf_model*.h5
flax_model*.msgpack

