.vscode/

# Local configuration and secrets
.env
.env.*
!.env.example
*.key
*.pem

# Go
core/bin/
core/coverage.out

# Desktop frontend
apps/desktop/node_modules/
apps/desktop/dist/

# MyGo desktop: development builds, release builds and the staged sidecars
apps/desktop/.mygo/
apps/desktop/build/
apps/desktop/resources/*-*/
apps/desktop/icons/.branding-hash
apps/desktop/icons/dev/.branding-hash
apps/desktop/internal/ui/icons/.branding-hash

# Local desktop installers (unsigned debug/dev DMGs)
/*.dmg

# Accidental root install leftovers
/node_modules/

# Rust workers
apps/privacy-worker/target/
apps/classifier-worker/target/
apps/classifier-worker/.venv/

# Local runtime data
/core.[0-9]*
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
data/
logs/

